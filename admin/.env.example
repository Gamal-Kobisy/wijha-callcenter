# =============================================================================
# WIJHA CALL CENTER — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local (never commit .env.local to git).
#
# SWITCHING BACKENDS:
#   - Railway:         VITE_API_URL=https://wijha-callcenter-production.up.railway.app/api/v1
#   - Google Cloud Run: VITE_API_URL=https://<your-service>.run.app/api/v1
#   - Local dev:       VITE_API_URL=http://localhost:3000/api/v1 (or omit entirely — this is the default)
#
# In Vercel, set VITE_API_URL under Project Settings ? Environment Variables.
# =============================================================================

# Backend API base URL (no trailing slash)
VITE_API_URL=https://wijha-callcenter-production.up.railway.app/api/v1
